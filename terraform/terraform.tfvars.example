# 复制为 terraform.tfvars 后填写真实值；terraform.tfvars 已被 gitignore。
region = "cn-hangzhou"

# 只允许你自己的公网 IP 访问 SSH / 6443 / NodePort
ssh_cidr       = "1.2.3.4/32"
node_port_cidr = "1.2.3.4/32"

# 阿里云 SSH 公钥整行内容，不要填文件路径
ssh_public_key = "ssh-ed25519 AAAA... you@example"

# 演示安装阶段建议 100 Mbps，装完可降回
internet_max_bandwidth_out = 100

# MySQL 已改用动态 ESSD；worker 数据盘仍供 containerd/kubelet/其他 local-path PVC 使用
# 80G 偏紧，演示建议 120G
worker_data_disk_size = 120

# 可选：自动选择可用区失败时手动指定
# availability_zone = "cn-hangzhou-i"

# 可选：地域内已有同名密钥对时改名或 import
# key_pair_name = "micro-bl-20261122"
