    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (destination_service_name) (rate(istio_requests_total{reporter=\"destination\", request_protocol=\"grpc\", grpc_response_status!=\"0\"}[5m])) / sum by (destination_service_name) (rate(istio_requests_total{reporter=\"destination\", request_protocol=\"grpc\"}[5m]))",
          "legendFormat": "{{destination_service_name}}",
          "refId": "A"
        }
